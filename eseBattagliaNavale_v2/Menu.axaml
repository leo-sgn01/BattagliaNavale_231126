<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="eseBattagliaNavale_v2.Main"
        Title="Battaglia Navale - Menu"
        Width="400" Height="300"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="30" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="txtTitolo" Text="BATTAGLIA NAVALE" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="txtSottotitolo" Text="Modalità: Giocatore Singolo" FontSize="14" HorizontalAlignment="Center" Foreground="Gray"/>
        <Button x:Name="btnInizia" Content="INIZIA PARTITA (Posiziona Navi)" Click="BtnInizia_Click" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                Background="#2B579A" Foreground="White" Padding="12" FontWeight="Bold"/>
    </StackPanel>
</Window>